{
  "name": "@heleg/runpad",
  "version": "0.1.1",
  "description": "Terminal UI for browsing and running package.json scripts in single packages and npm, Yarn, pnpm and Bun workspaces.",
  "keywords": [
    "bun",
    "cli",
    "ink",
    "interactive",
    "monorepo",
    "npm",
    "npm-scripts",
    "package-json",
    "pnpm",
    "script-runner",
    "scripts",
    "task-runner",
    "terminal",
    "tui",
    "workspaces",
    "yarn"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heleg/runpad.git"
  },
  "bin": {
    "rp": "dist/index.mjs",
    "runpad": "dist/index.mjs"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "lefthook install",
    "start": "bun run src/index.ts",
    "build": "tsdown",
    "schema": "bun run scripts/configJsonSchema.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "execa": "^10.2.1",
    "ink": "^8.0.0",
    "minimatch": "^11.0.8",
    "nypm": "^0.6.12",
    "react": "^19.3.1",
    "valibot": "^1.5.0",
    "withstand": "^0.0.28",
    "wrap-ansi": "^10.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@valibot/to-json-schema": "^1.8.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
