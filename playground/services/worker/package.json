{
  "name": "@runpad/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mock worker workspace for script discovery and execution.",
  "scripts": {
    "dev": "node ../../scripts/mock-task.mjs dev --port=4118 --title=\"@runpad/worker development\"",
    "build": "node ../../scripts/mock-task.mjs build --mode=development --title=\"@runpad/worker local preview\"",
    "start": "node ../../scripts/mock-task.mjs start",
    "test": "node --test",
    "lint": "node ../../scripts/mock-task.mjs lint",
    "jobs:replay": "node ../../scripts/mock-task.mjs jobs:replay",
    "queue:drain": "node ../../scripts/mock-task.mjs queue:drain",
    "clean": "node ../../scripts/mock-task.mjs clean",
    "info": "node -p \"process.cwd()\"",
    "runtime": "node --version",
    "build:release": "node ../../scripts/mock-task.mjs clean && node ../../scripts/mock-task.mjs build --mode=production --title=\"@runpad/worker production release preview\" && node ../../scripts/mock-task.mjs analyze --report=release-source-inventory-with-sha256-checksums.json",
    "inventory": "node ../../scripts/mock-task.mjs inventory"
  },
  "dependencies": {
    "@runpad/database": "workspace:*",
    "@runpad/logger": "workspace:*",
    "@runpad/queue": "workspace:*"
  }
}
