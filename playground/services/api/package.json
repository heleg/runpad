{
  "name": "@runpad/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mock api workspace for script discovery and execution.",
  "scripts": {
    "dev": "node ../../scripts/mock-task.mjs dev --port=4116 --title=\"@runpad/api development\"",
    "build": "node ../../scripts/mock-task.mjs build --mode=development --title=\"@runpad/api local preview\"",
    "start": "node ../../scripts/mock-task.mjs start",
    "test": "node --test",
    "test:integration": "node ../../scripts/mock-task.mjs test:integration",
    "lint": "node ../../scripts/mock-task.mjs lint",
    "openapi:generate": "node ../../scripts/mock-task.mjs openapi:generate",
    "clean": "node ../../scripts/mock-task.mjs clean",
    "check:syntax": "node ../../scripts/mock-task.mjs check:syntax",
    "info": "node -p \"process.cwd()\"",
    "runtime": "node --version",
    "build:release": "node ../../scripts/mock-task.mjs clean && node ../../scripts/mock-task.mjs build --mode=production --title=\"@runpad/api production release preview\" && node ../../scripts/mock-task.mjs analyze --report=release-source-inventory-with-sha256-checksums.json",
    "inventory": "node ../../scripts/mock-task.mjs inventory"
  },
  "dependencies": {
    "@runpad/database": "workspace:*",
    "@runpad/auth": "workspace:*",
    "@runpad/logger": "workspace:*",
    "@runpad/validation": "workspace:*"
  }
}
