{
  "name": "@runpad/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mock web workspace for script discovery and execution.",
  "scripts": {
    "dev": "node ../../scripts/mock-task.mjs dev --port=4103 --title=\"@runpad/web development\"",
    "build": "node ../../scripts/mock-task.mjs build --mode=development --title=\"@runpad/web local preview\"",
    "start": "node ../../scripts/mock-task.mjs start",
    "preview": "node ../../scripts/mock-task.mjs preview",
    "test": "node --test",
    "test:watch": "node ../../scripts/mock-task.mjs test:watch",
    "lint": "node ../../scripts/mock-task.mjs lint",
    "analyze": "node ../../scripts/mock-task.mjs analyze",
    "clean": "node ../../scripts/mock-task.mjs clean",
    "dev:debug": "node --inspect=0 ../../scripts/mock-task.mjs dev --port=3100 --title=\"Web debug preview\"",
    "test:unit": "node ../../scripts/mock-task.mjs test --suite unit",
    "test:e2e": "node ../../scripts/mock-task.mjs test --suite e2e",
    "build:production": "node ../../scripts/mock-task.mjs build --mode production",
    "demo:fail": "node ../../scripts/mock-task.mjs demo:fail",
    "demo:slow": "node ../../scripts/mock-task.mjs demo:slow --iterations=1000000",
    "demo:stderr": "node ../../scripts/mock-task.mjs demo:stderr",
    "check:syntax": "node ../../scripts/mock-task.mjs check:syntax",
    "info": "node -p \"process.cwd()\"",
    "runtime": "node --version",
    "build:release": "node ../../scripts/mock-task.mjs clean && node ../../scripts/mock-task.mjs build --mode=production --title=\"@runpad/web production release preview\" && node ../../scripts/mock-task.mjs analyze --report=release-source-inventory-with-sha256-checksums.json",
    "inventory": "node ../../scripts/mock-task.mjs inventory"
  },
  "dependencies": {
    "@runpad/ui": "workspace:*",
    "@runpad/auth": "workspace:*",
    "@runpad/api-client": "workspace:*"
  }
}
