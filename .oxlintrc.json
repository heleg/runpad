{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "curly": 2
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "tests/fixtures/**",
    "playground/**",
    "website/.astro/**",
    "website/dist/**"
  ]
}
